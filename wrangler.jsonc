{
  // SubForge.rs — Cloudflare Workers 配置。
  // 管理密码不写在这里：本地用 .dev.vars，线上用 `wrangler secret put SUBFORGE_PASSWORD`。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subforge-rs",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-23",
  "build": {
    "command": "worker-build --release"
  },
  "durable_objects": {
    "bindings": [{ "name": "CORE", "class_name": "Core" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Core"] }],
  "r2_buckets": [{ "binding": "CACHE", "bucket_name": "subforge-cache" }],
  // 每 6 小时检查一次：只刷新到期上游；GeoIP 按设置的天数决定是否更新。
  "triggers": { "crons": ["15 */6 * * *"] },
  "observability": { "enabled": true }
}
